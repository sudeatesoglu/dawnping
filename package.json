{
  "name": "dawnping",
  "version": "0.0.0",
  "private": true,
  "description": "Start your Claude Code usage window at the right time, learned from your own work pattern.",
  "keywords": [
    "claude-code",
    "cli",
    "productivity",
    "macos"
  ],
  "license": "UNLICENSED",
  "author": "Sude Ateşoğlu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudeatesoglu/dawnping.git"
  },
  "type": "module",
  "bin": {
    "dawnping": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p src/core/tsconfig.json && tsc -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "lefthook": "2.2.2",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "commander": "^15.1.0"
  }
}
